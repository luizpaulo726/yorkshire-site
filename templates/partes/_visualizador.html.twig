{# Visualizador de fotos da galeria (comportamento em assets/js/galeria.js) #}
<dialog class="visualizador" id="visualizador" aria-label="Foto ampliada">
    <button type="button" class="visualizador__fechar" id="visualizador-fechar" aria-label="Fechar">×</button>
    <button type="button" class="visualizador__nav visualizador__nav--anterior" id="visualizador-anterior" aria-label="Foto anterior">‹</button>
    <figure>
        <img id="visualizador-imagem" src="" alt="">
        <figcaption id="visualizador-legenda"></figcaption>
    </figure>
    <button type="button" class="visualizador__nav visualizador__nav--proxima" id="visualizador-proxima" aria-label="Próxima foto">›</button>
</dialog>
